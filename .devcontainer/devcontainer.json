{
  "name": "Q-Mem Stack Builder",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 8,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "docker --version && docker compose --version",
  "customizations": {
    "codespaces": {
      "machine": "premiumLinux"
    }
  }
}
